# Copie para `.env` e ajuste. TODOS os valores abaixo são fictícios (apenas para dev local):
# gere valores novos e secretos para produção (ver comandos nos comentários).

# --- Postgres -----------------------------------------------------------------------------
POSTGRES_USER=central
# Entra na DATABASE_URL sem URL-encoding: use só caracteres seguros (hex). Prod: `openssl rand -hex 32`.
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=central

# --- Aplicação (web) ----------------------------------------------------------------------
# Origem pública do painel; requisições mutáveis exigem Origin igual a este valor.
APP_ORIGIN=http://localhost
# Dev: vazio -> o Caddy atende http://localhost. Prod: domínio do painel (TLS automático).
PANEL_DOMAIN=
# Selo do cookie de sessão, mínimo de 32 caracteres. Prod: `openssl rand -base64 48`.
NUXT_SESSION_PASSWORD=dev-only-session-password-0123456789abcdef
TOTP_ISSUER=Central de Conteúdo
# true atrás do Caddy (IP do cliente vem em X-Forwarded-For, sobrescrito pelo Caddy).
TRUST_PROXY=true
# Chaves AES-256-GCM: `versão:chave-base64-de-32-bytes`, lista separada por vírgula A maior versão cifra;
# as demais só decifram (rotação). Prod: `echo "1:$(openssl rand -base64 32)"`.
APP_ENCRYPTION_KEYS=1:ZmljdGl0aW91cy1kZXYta2V5LW5vdC1zZWNyZXQtMDA=
LOG_LEVEL=info
# Sentry: só o worker inicializa (Fase 1).
# SENTRY_DSN=

# --- Integrações (opcionais; ver docs/runbooks/meta-app.md e google-oauth.md) -------------------
# Sem elas o painel funciona e as telas de conexão respondem 503 "Integração não configurada".
# Meta: as TRÊS são necessárias. A versão da Graph API (formato vNN.N) não tem valor padrão:
# use a versão com a qual o app foi validado.
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=
# Google (YouTube): as DUAS são necessárias. O redirect cadastrado no Google é
# <APP_ORIGIN>/api/oauth/youtube/callback.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# --- IA (worker; opcionais) ----------------------------------------------------------------
# Só o worker recebe estas chaves; nunca aparecem em logs. Sem as DUAS a análise de vídeo termina
# em "Integração de IA não configurada.". AI_MODEL padrão: claude-opus-5-5 (precisa ter preço
# cadastrado em packages/ai/src/pricing.ts).
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Download por link do YouTube (worker; desligado por padrão) ----------------------------
# Usa o yt-dlp (ferramenta não oficial, fora da API do YouTube): pode violar os termos do YouTube
# e ter o IP bloqueado (docs/07-integracoes/youtube.md §17). Ligue só sabendo disso; o MP4 enviado
# continua sendo o caminho garantido. Na imagem do worker o binário já vem em /usr/local/bin.
# YTDLP_ENABLED=false
# YTDLP_PATH=yt-dlp

# --- Storage S3 ---------------------------------------------------------------------------
# Dev (compose.yaml): MinIO local; o endpoint e o path-style são fixados no compose e as
# credenciais vêm de MINIO_ROOT_*. Prod (compose.prod.yaml): Cloudflare R2 (variáveis S3_*).
MINIO_ROOT_USER=devminio
MINIO_ROOT_PASSWORD=dev-only-minio-password
S3_BUCKET=central-media
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=dev-only-access-key-id
S3_SECRET_ACCESS_KEY=dev-only-secret-access-key
S3_FORCE_PATH_STYLE=false

# --- Imagens (compose.prod.yaml) ----------------------------------------------------------
IMAGE_OWNER=owner
IMAGE_TAG=latest
