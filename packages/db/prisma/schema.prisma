generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  admin
  member
}

enum UserStatus {
  active
  disabled
}

enum OrganizationRole {
  viewer
  editor
  approver
  admin
}

model User {
  id               String      @id @default(uuid(7)) @db.Uuid
  email            String      @unique
  name             String
  passwordHash     String
  totpSecretEnc    String?
  totpEnabledAt    DateTime?   @db.Timestamptz(3)
  totpLastUsedStep BigInt?
  role             GlobalRole  @default(member)
  status           UserStatus  @default(active)
  sessionVersion   Int         @default(1)
  lastLoginAt      DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  memberships      OrganizationMember[]
  auditLogs        AuditLog[]
}

model Organization {
  id                 String        @id @default(uuid(7)) @db.Uuid
  name               String
  slug               String        @unique
  timezone           String        @default("America/Sao_Paulo")
  locale             String        @default("pt-BR")
  tags               String[]      @default([])
  voiceGuide         String        @default("")
  fixedHashtags      String[]      @default([])
  creditTemplate     String        @default("Créditos: {creator}")
  captionStyle       Json          @default("{}")
  clipDefaults       Json          @default("{\"targetMin\":5,\"targetMax\":10,\"minSec\":30,\"maxSec\":90}")
  retention          Json          @default("{\"sourceDays\":30,\"unusedSourceDays\":14,\"clipDays\":90}")
  aiMonthlyBudgetUsd Decimal       @default(50) @db.Decimal(10, 2)
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  members            OrganizationMember[]
  settings           Setting[]
  auditLogs          AuditLog[]
}

model OrganizationMember {
  organizationId   String    @db.Uuid
  userId    String    @db.Uuid
  role      OrganizationRole
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
}

// O índice único (organizationId, key) NULLS NOT DISTINCT é criado por SQL manual
// na migração, pois o Prisma não o expressa.
model Setting {
  id        String   @id @default(uuid(7)) @db.Uuid
  organizationId   String?  @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  organizationId    String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  diff       Json?
  ip         String?
  at         DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, at])
}

model Heartbeat {
  name      String   @id
  at        DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
